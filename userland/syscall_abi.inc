	.set SYS_WRITE, 1
	.set SYS_YIELD, 2
	.set SYS_EXIT, 3
	.set SYS_TIME, 4
	.set SYS_READ, 5
	.set SYS_SPAWN, 6
	.set SYS_OPEN, 7
	.set SYS_CLOSE, 8
